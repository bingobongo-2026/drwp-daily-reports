# ==========================================================================
# 日報マン ライセンスサーバー 環境変数
# 本番では必ず DRWP_ADMIN_TOKEN を強いランダム値に変更してください。
# ==========================================================================

# --- 必須 ---
# 管理画面 / 管理API の Basic 認証パスワード(ユーザー名は下の
# DRWP_ADMIN_USERNAME、既定は "admin")。設定画面から変更した場合は
# DB の値が優先される。
DRWP_ADMIN_TOKEN=change-this

# SQLite データベースファイルのパス
DRWP_LICENSE_DB=./data.sqlite3

# Ed25519 署名鍵ファイルのパス(無ければ起動時に自動生成・chmod 600)
DRWP_SIGNING_KEY=./signing.key

# --- 認証 ---
# 管理ユーザー名(既定: admin)。DB に保存された値があればそちらが優先。
DRWP_ADMIN_USERNAME=admin

# ログイン失敗のレート制限。「WINDOW 秒以内に LIMIT 回失敗したら、
# 最後の失敗から BLOCK 秒間 429 で遮断」。totp の失敗も数える。
DRWP_LOGIN_FAIL_LIMIT=10
DRWP_LOGIN_FAIL_WINDOW=300
DRWP_LOGIN_BLOCK_SECONDS=600

# 成功ログインも監査ログに残すか(0 で残さない)
DRWP_AUDIT_SUCCESS=1

# --- リバースプロキシ配下での運用 ---
# nginx 等の背後に置く場合は 1 にする。X-Forwarded-For の先頭を
# クライアントIPとして扱う(レート制限が全員同一IP=プロキシに見えて
# 巻き添え遮断されるのを防ぐ)。直接公開なら 0 のまま。
# ※あわせて uvicorn を --proxy-headers 付きで起動すること(Dockerfile 済み)。
DRWP_TRUST_PROXY=0

# --- 2要素認証 (TOTP) ---
# 1 にすると 2FA 機能そのものを無効化する(緊急時の締め出し回避用)
DRWP_TOTP_DISABLED=0
# 2FA セッション Cookie の有効時間(時間)
DRWP_TOTP_SESSION_HOURS=12

# --- 署名鍵の自動ローテート ---
# 何日ごとに署名鍵を自動ローテートするか(0 で無効)
DRWP_ROTATION_INTERVAL_DAYS=90
# ローテート要否を何時間ごとにチェックするか
DRWP_ROTATION_CHECK_HOURS=6

# --- 監査ログ ---
# 監査ログを何日分残すか(古い行は自動削除。0 で削除しない)
DRWP_AUDIT_RETENTION_DAYS=90

# --- バックアップ ---
# 設定すると、バックアップをこのパスフレーズ由来の鍵で暗号化した
# .zip.enc として払い出す(復元にも同じ値が必要)。バックアップには
# 署名秘密鍵とライセンス DB が丸ごと入るため、保管先が第三者に渡り
# 得る場合は設定を推奨。未設定なら従来どおり平文 zip。
# DRWP_BACKUP_PASSPHRASE=

# --- フリープラン ---
# フリープランで有効期限未指定のとき、何日後を自動設定するか
DRWP_FREE_PLAN_DAYS=30
